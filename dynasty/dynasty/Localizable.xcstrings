      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Train %1$@ at %2$@?\nCurrent: %3$lld%% / Ceiling: %4$lld%%\nThis is a slow process that takes multiple seasons. At %5$lld%% familiarity the move becomes PERMANENT — he changes position for good and his ratings are rebuilt around %6$@. Stop the programme before then if you only want a backup there."
          }
        }
      }
